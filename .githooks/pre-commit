#!/usr/bin/env sh
set -eu
export PYTHONDONTWRITEBYTECODE=1

echo "ARR pre-commit: git diff --check"
git diff --cached --check

if [ -n "${PYTHON:-}" ]; then
  PYTHON_BIN="$PYTHON"
elif [ -x "_codex_runtime/tmp/venv-final-pass/Scripts/python.exe" ]; then
  PYTHON_BIN="_codex_runtime/tmp/venv-final-pass/Scripts/python.exe"
elif [ -x "_codex_runtime/tmp/venv-arr/Scripts/python.exe" ]; then
  PYTHON_BIN="_codex_runtime/tmp/venv-arr/Scripts/python.exe"
else
  PYTHON_BIN="python"
fi

echo "ARR pre-commit: sintaxis Python sin caches"
"$PYTHON_BIN" -c "from pathlib import Path; files=[Path('conftest.py'), *Path('services').rglob('*.py'), *Path('tests').rglob('*.py')]; [compile(path.read_bytes(), str(path), 'exec') for path in files]; print(f'PYTHON_SYNTAX_OK {len(files)}')"

if ! command -v node >/dev/null 2>&1; then
  echo "ARR pre-commit: node no esta disponible para validar panel.js" >&2
  exit 1
fi

echo "ARR pre-commit: node --check services/media-panel/media_panel/web/static/js/panel.js y todos los modulos JS"
git ls-files '*.js' | while IFS= read -r JS_FILE; do
  [ -n "$JS_FILE" ] || continue
  node --check "$JS_FILE"
done

echo "ARR pre-commit: contratos rapidos"
"$PYTHON_BIN" -m pytest -q -p no:cacheprovider \
  tests/test_project_governance.py \
  tests/test_pytest_contracts.py \
  services/arr-orchestrator/tests/test_arr_blackbox.py \
  services/arr-orchestrator/tests/test_arr_follow.py \
  services/series-worker/tests \
  services/buscador-puente-arr/tests/test_arr_trace.py
